<?xml version="1.0" encoding="UTF-8"?>
<ExtensionManifest Version="11.0" ExtensionBundleId="com.donyaep.LayersPanePlus" ExtensionBundleVersion="__APP_VERSION__"
    ExtensionBundleName="Layers Pane Plus" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <ExtensionList>
        <Extension Id="com.donyaep.LayersPanePlus.panel" Version="__APP_VERSION__"/>
    </ExtensionList>
    <ExecutionEnvironment>
        <HostList>
            <!-- After Effects 2022 (22.0) and above – CEP 11 / Chromium 88. Floor raised to 22.0
                 because duplicateLayer relies on Layer.id, introduced in After Effects 22.0. -->
            <Host Name="AEFT" Version="22.0"/>
        </HostList>
        <LocaleList>
            <Locale Code="All"/>
        </LocaleList>
        <RequiredRuntimeList>
            <RequiredRuntime Name="CSXS" Version="11.0"/>
        </RequiredRuntimeList>
    </ExecutionEnvironment>
    <DispatchInfoList>
        <Extension Id="com.donyaep.LayersPanePlus.panel">
            <DispatchInfo>
                <Resources>
                    <MainPath>./index.html</MainPath>
                    <ScriptPath>./jsx/scripts.jsx</ScriptPath>
                </Resources>
                <Lifecycle>
                    <AutoVisible>true</AutoVisible>
                </Lifecycle>
                <UI>
                    <Type>Panel</Type>
                    <Menu>Layers Pane Plus</Menu>
                    <Geometry>
                        <Size>
                            <Height>400</Height>
                            <Width>320</Width>
                        </Size>
                        <MinSize>
                            <Height>200</Height>
                            <Width>240</Width>
                        </MinSize>
                        <MaxSize>
                            <Height>900</Height>
                            <Width>600</Width>
                        </MaxSize>
                    </Geometry>
                </UI>
            </DispatchInfo>
        </Extension>
    </DispatchInfoList>
</ExtensionManifest>
